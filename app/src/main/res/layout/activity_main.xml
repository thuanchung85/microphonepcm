<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView"
        android:layout_width="344dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.11" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"

        android:layout_height="142dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_gravity="center"

            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatButton
                android:layout_gravity="center"
                android:id="@+id/buttonRecord"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/background_corner_shap4"
                android:drawableLeft="@drawable/microphone_342"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingLeft="35dp"
                android:shadowColor="#000000"
                android:shadowDx="2.5"
                android:shadowDy="2.3"
                android:shadowRadius="2.6"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:layout_gravity="center"
                android:visibility="gone"
                android:id="@+id/buttonStop"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/background_corner_shap4"
                android:drawableLeft="@drawable/video_pause_button"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingLeft="20dp"
                android:shadowColor="#000000"
                android:shadowDx="2.5"
                android:shadowDy="2.3"
                android:shadowRadius="2.6"
                />
        </FrameLayout>

    </LinearLayout>

    <Button
        android:id="@+id/buttonOKFileWAV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/black"
        android:text="OK FILE WAV VOICE DONE"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintStart_toStartOf="@+id/linearLayout" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonPlay"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/background_corner_shap4"
        android:drawableLeft="@drawable/play_svgrepo_com"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingLeft="30dp"
        android:shadowColor="#000000"
        android:shadowDx="2.5"
        android:shadowDy="2.3"
        android:shadowRadius="2.6"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />


</androidx.constraintlayout.widget.ConstraintLayout>