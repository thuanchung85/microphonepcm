
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "shadow" -->
    <item >
        <shape android:shape="rectangle" >
            <solid android:color="#30E8E9ED"
                />

            <corners android:radius="30dp" />
        </shape>
    </item>

    <item
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp">

        <shape
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">


            <gradient
                android:angle="90"
                android:endColor="#40000000"
                android:startColor="#BB000000"/>



            <stroke
                android:width="1dp"
                android:color="#c3c3c3" >
            </stroke>

            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"    >
            </padding>

            <corners
                android:radius="21dp"   >
            </corners>

        </shape>
    </item>
</layer-list>
